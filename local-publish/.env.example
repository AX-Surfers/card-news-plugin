# cardnews local runtime — environment template
# Copy to  ~/.local/share/cardnews/.env  and fill VALUES (never commit this file).
# File perms must be 600. The publish scripts load these themselves.

# ---- Notion approval gate ----
NOTION_API_KEY=
# or: NOTION_API_TOKEN=

# ---- Instagram (Meta Graph API) ----
INSTAGRAM_GRAPH_TOKEN=
# fallback if above empty:
# META_GRAPH_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# optional (long-lived token refresh):
# META_APP_ID=
# META_APP_SECRET=
# META_APP_SECRET_FILE=~/.local/share/cardnews/.secrets/meta_app_secret.txt

# ---- Threads ----
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# optional:
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ---- Google Drive (public image hosting for carousels) ----
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=~/.local/share/cardnews/.secrets/google_drive_sa.json
# REQUIRED: a Shared Drive (or folder) id the service account is a member of.
# The SA has 0 personal Drive quota, so uploads to My Drive 403. Point this at a
# Shared Drive the SA can write to. (e.g. the "SNS Image" shared drive)
GOOGLE_DRIVE_PARENT_ID=

# ---- File-path variants (scripts read token from file if set) ----
# INSTAGRAM_GRAPH_TOKEN_FILE=~/.local/share/cardnews/.secrets/instagram_token.txt
# META_GRAPH_ACCESS_TOKEN_FILE=~/.local/share/cardnews/.secrets/meta_system_user_token.txt
# THREADS_ACCESS_TOKEN_FILE=~/.local/share/cardnews/.secrets/threads_token.txt

# ---- Layout root (usually leave default) ----
# CARDNEWS_DATA_ROOT=~/.local/share/cardnews
